@startuml Feature4_UseCaseDiagram

title Feature 4: View Member/Guest List of a Class

left to right direction

' ── Actors ──────────────────────────────────────────
actor "Trainer"       as Trainer
actor "Admin"         as Admin

' ── System boundary ──────────────────────────────────
rectangle "Fitness Class System" {

    usecase "View Class Member List"         as UC1
    usecase "Retrieve Member Details\n(name, email, contact)" as UC2
    usecase "View Empty Member List"         as UC3
    usecase "Handle Invalid Class ID"        as UC4

}

' ── Associations ─────────────────────────────────────
Trainer --> UC1
Admin   --> UC1

' UC1 always retrieves member details
UC1 ..> UC2 : <<include>>

' Extensions of UC1
UC1 ..> UC3 : <<extend>>\n[no bookings found]
UC1 ..> UC4 : <<extend>>\n[class ID is blank/invalid]

@enduml
